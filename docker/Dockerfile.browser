FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc xdotool curl ca-certificates \
      libgtk-3-0 libdbus-glib-1-2 libxt6 libasound2 libx11-xcb1 libxcomposite1 \
      libxcursor1 libxdamage1 libxi6 libxrandr2 libxtst6 libpci3 libnss3 \
      libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libcups2 libdrm2 libgbm1 \
      libxkbcommon0 libxfixes3 libxshmfence1 libpango-1.0-0 libcairo2 \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Install obscura binary (latest release); the tag is recorded for the Settings -> Browser backends card
RUN tag="$(curl -fsSLo /dev/null -w '%{url_effective}' https://github.com/h4ckf0r0day/obscura/releases/latest | sed 's#.*/tag/##')" \
    && curl -fsSL "https://github.com/h4ckf0r0day/obscura/releases/download/${tag}/obscura-x86_64-linux.tar.gz" | tar -xz -C /usr/local/bin \
    && chmod +x /usr/local/bin/obscura \
    && mkdir -p /usr/local/share/mendarr && echo "$tag" > /usr/local/share/mendarr/obscura.version

RUN useradd --create-home --uid 1000 mendarr && mkdir /app && chown mendarr /app \
    && mkdir -p /data/backends && chown -R mendarr /data
USER mendarr

# the venv must belong to the runtime user: camoufox/fpgen write their model into site-packages
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/home/mendarr/.cache/ms-playwright
WORKDIR /app

# deps first so source edits don't bust this layer
COPY --chown=mendarr pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra browser --no-install-project

# Chromium needs only the patchright package from the deps layer, so it sits before the source COPY
RUN patchright install chromium

# fetched as the runtime user so the browser lands in its cache (~/.cache/camoufox); the official releases are
# gone since the maintainers' GitHub accounts were suspended (2026-11-19), so fall back to the mirror.
# Done before the source COPY so code edits don't re-download ~1.3 GB: the helper runs standalone from /tmp
# (--url given, so it never imports the mendarr package) and is removed again.
ARG CAMOUFOX_MIRROR_URL=https://api.github.com/repos/jo-inc/camofox-browser/releases
COPY --chown=mendarr src/mendarr/worker/camoufox_mirror.py /tmp/camoufox_mirror.py
# `camoufox fetch` exits 0 even when the download failed, so success is judged by installed_verstr();
# the last check fails the build instead of shipping an image without a browser
RUN (camoufox fetch; python -c "from camoufox.pkgman import installed_verstr; installed_verstr()") \
    || python /tmp/camoufox_mirror.py install --pinned --url "$CAMOUFOX_MIRROR_URL"; \
    rm -f /tmp/camoufox_mirror.py; \
    python -c "from camoufox.pkgman import installed_verstr; print('camoufox', installed_verstr())"

COPY --chown=mendarr src ./src
RUN uv sync --frozen --no-dev --extra browser

# plugin code runs as this user: it must not be able to patch the app or the venv,
# but fpgen must manage its model data inside site-packages
USER root
RUN chown -R root:root /app && chmod -R go-w /app \
    && chown -R mendarr:mendarr /app/.venv/lib/python3.12/site-packages/fpgen
USER mendarr

EXPOSE 8192
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8192/health', timeout=3)"
CMD ["mendarr-worker"]
