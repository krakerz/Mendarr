FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc xdotool curl ca-certificates \
      libgtk-3-0 libdbus-glib-1-2 libxt6 libasound2 libx11-xcb1 libxcomposite1 \
      libxcursor1 libxdamage1 libxi6 libxrandr2 libxtst6 libpci3 libnss3 \
      libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libcups2 libdrm2 libgbm1 \
      libxkbcommon0 libxfixes3 libxshmfence1 libpango-1.0-0 libcairo2 \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Install obscura binary (latest release)
RUN curl -fsSL "https://github.com/h4ckf0r0day/obscura/releases/latest/download/obscura-x86_64-linux.tar.gz" | tar -xz -C /usr/local/bin \
    && chmod +x /usr/local/bin/obscura

RUN useradd --create-home --uid 1000 mendarr && mkdir /app && chown mendarr /app
USER mendarr

# the venv must belong to the runtime user: camoufox/fpgen write their model into site-packages
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
WORKDIR /app

# deps first so source edits don't bust this layer
COPY --chown=mendarr pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra browser --no-install-project

COPY --chown=mendarr src ./src
RUN uv sync --frozen --no-dev --extra browser

# fetched as the runtime user so the browser lands in its cache (~/.cache/camoufox)
RUN camoufox fetch && patchright install chromium

# plugin code runs as this user: it must not be able to patch the app or the venv
USER root
RUN chown -R root:root /app && chmod -R go-w /app
USER mendarr

EXPOSE 8192
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8192/health', timeout=3)"
CMD ["mendarr-worker"]
